# =====================================================================
# Production & Render Environment Variables Configuration
# Copy this file to .env for local testing (DO NOT commit your real .env)
# =====================================================================

# AWS S3 Configuration
# In production on Render, set these in the Render Dashboard Environment tab.
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=ap-south-1
S3_BUCKET_NAME=cloud-mini-project-vipul-2026

# AES-256-GCM Master Encryption Key (64 hex characters = 32 raw bytes)
# In production on Render, set this environment variable so that container restarts
# preserve access to files previously uploaded to S3 without re-generating keys.
# Export your local key via: python export_master_key.py
ENCRYPTION_MASTER_KEY_HEX=

# Allowed CORS Origins (Comma-separated)
# Grants access to Cloudflare Pages portfolio and localhost
CORS_ORIGINS=https://quiet-night-ad88.vipulrekhi.workers.dev,http://127.0.0.1:5000,http://localhost:5000

# Server Port (Render sets this dynamically)
PORT=5000
